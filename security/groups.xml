<odoo>
    <record id="group_university_manager" model="res.groups">
        <field name="name">University Manager</field>
        <field name="category_id" ref="module_category_university_erp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_student" model="res.groups">
        <field name="name">Student</field>
        <field name="category_id" ref="module_category_university_erp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="student_portal_rule" model="ir.rule">
        <field name="name">Student Own Record</field>
        <field name="model_id" ref="model_student_university"/>
        <field name="groups" eval="[(4, ref('group_student'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
<record id="group_registrar" model="res.groups"><field name="name">Registrar / Academic Office</field><field name="category_id" ref="module_category_university_erp"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record><record id="group_coordinator" model="res.groups"><field name="name">Programme Coordinator</field><field name="category_id" ref="module_category_university_erp"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record><record id="group_lecturer" model="res.groups"><field name="name">Lecturer</field><field name="category_id" ref="module_category_university_erp"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record><record id="group_exam_board" model="res.groups"><field name="name">Examination Board</field><field name="category_id" ref="module_category_university_erp"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record><record id="group_finance_officer" model="res.groups"><field name="name">Student Finance Officer</field><field name="category_id" ref="module_category_university_erp"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record><record id="group_library_officer" model="res.groups"><field name="name">Student Library Officer</field><field name="category_id" ref="module_category_university_erp"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record></odoo>
