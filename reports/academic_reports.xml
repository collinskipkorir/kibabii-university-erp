<odoo>
    <template id="report_graduation_eligibility">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="web.external_layout"><div class="page">
            <h2>Graduation Eligibility Report</h2><p><strong>Student: </strong><span t-field="doc.name"/></p><p>Admission: <span t-field="doc.admission_number"/></p><p>Programme: <span t-field="doc.programme_id.name"/></p>
            <table class="table table-bordered"><tbody><tr><th>Published Credits</th><td><span t-field="doc.published_credits"/></td></tr><tr><th>Required Credits</th><td><span t-field="doc.programme_id.required_credits"/></td></tr><tr><th>Published GPA</th><td><span t-field="doc.published_gpa"/></td></tr><tr><th>Academic Clearance</th><td t-esc="'Cleared' if doc.academic_cleared else 'Pending / Blocked'"/></tr><tr><th>Financial Clearance</th><td t-esc="'Cleared' if doc.financial_cleared else 'Pending / Blocked'"/></tr><tr><th>Library Clearance</th><td t-esc="'Cleared' if doc.library_cleared else 'Pending / Blocked'"/></tr><tr><th>Outstanding Fees</th><td><span t-field="doc.fee_balance"/></td></tr><tr><th>Eligible</th><td t-esc="'Yes' if doc.graduation_eligible else 'No'"/></tr></tbody></table>
            <p t-if="doc.graduation_blockers" t-esc="doc.graduation_blockers"/><p>Final authorization: <span t-field="doc.registration_state"/></p><p>Authorized by: <span t-field="doc.graduation_by.name"/></p>
        </div></t></t></t>
    </template>
    <record id="action_graduation_eligibility" model="ir.actions.report"><field name="name">Graduation Eligibility</field><field name="model">student.university</field><field name="report_type">qweb-pdf</field><field name="report_name">kibabii-university-erp.report_graduation_eligibility</field><field name="binding_model_id" ref="model_student_university"/><field name="binding_type">report</field><field name="groups_id" eval="[(6,0,[ref('group_registrar'),ref('group_university_manager')])]"/></record>
    <template id="report_class_attendance"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="web.external_layout"><div class="page"><h2>Class Attendance Register</h2><p t-field="doc.name"/><p t-field="doc.start_datetime"/><table class="table"><thead><tr><th>Student</th><th>Admission</th><th>Status</th></tr></thead><tbody><tr t-foreach="doc.attendance_ids" t-as="line"><td t-esc="line.student_id.name"/><td t-esc="line.student_id.admission_number"/><td t-esc="line.status"/></tr></tbody></table></div></t></t></t></template>
    <record id="action_class_attendance" model="ir.actions.report"><field name="name">Class Attendance Register</field><field name="model">university.class.session</field><field name="report_type">qweb-pdf</field><field name="report_name">kibabii-university-erp.report_class_attendance</field><field name="binding_model_id" ref="model_university_class_session"/><field name="binding_type">report</field></record>
    <template id="report_progression"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="web.external_layout"><div class="page"><h2>Academic Progression Decision</h2><p t-field="doc.student_id.name"/><p t-field="doc.semester_id.name"/><p>Earned credits: <span t-field="doc.earned_credits"/></p><p>Failed courses: <span t-field="doc.failed_courses"/></p><p>GPA: <span t-field="doc.gpa"/></p><p>Decision: <span t-field="doc.decision"/></p><p>Approval: <span t-field="doc.state"/></p><p t-field="doc.evaluation_notes"/><p>Approved by: <span t-field="doc.approved_by.name"/></p></div></t></t></t></template>
    <record id="action_progression_report" model="ir.actions.report"><field name="name">Progression Decision</field><field name="model">university.progression</field><field name="report_type">qweb-pdf</field><field name="report_name">kibabii-university-erp.report_progression</field><field name="binding_model_id" ref="model_university_progression"/><field name="binding_type">report</field></record>
</odoo>
