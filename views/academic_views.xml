  <record id="p7_student_university_form" model="ir.ui.view">
    <field name="name">student.university.form</field>
    <field name="model">student.university</field>
    <field name="priority">1</field>
    <field name="arch" type="xml">
      <form string="Student Profiles">
        <header>
          <field name="registration_state" widget="statusbar"/>
          <button name="action_submit_application" type="object" string="Submit Application" groups="kibabii-university-erp.group_registrar,kibabii-university-erp.group_university_manager" invisible="registration_state not in ('applicant',)"/>
          <button name="action_verify_application" type="object" string="Verify Application" groups="kibabii-university-erp.group_registrar,kibabii-university-erp.group_university_manager" invisible="registration_state not in ('submitted',)"/>
          <button name="action_admit" type="object" string="Approve Admission" groups="kibabii-university-erp.group_registrar,kibabii-university-erp.group_university_manager" invisible="registration_state not in ('verified',)"/>
          <button name="action_confirm_registration" type="object" string="Confirm Registration" groups="kibabii-university-erp.group_registrar,kibabii-university-erp.group_university_manager" invisible="registration_state not in ('admitted',)"/>
          <button name="action_return_application" type="object" string="Return for Correction" groups="kibabii-university-erp.group_registrar,kibabii-university-erp.group_university_manager" invisible="registration_state not in ('submitted', 'verified')"/>
          <button name="action_reject_application" type="object" string="Reject" groups="kibabii-university-erp.group_registrar,kibabii-university-erp.group_university_manager" invisible="registration_state not in ('submitted', 'verified')"/>
          <button name="action_suspend" type="object" string="Suspend" groups="kibabii-university-erp.group_registrar,kibabii-university-erp.group_university_manager" invisible="registration_state not in ('registered',)"/>
          <button name="action_reinstate" type="object" string="Reinstate" groups="kibabii-university-erp.group_registrar,kibabii-university-erp.group_university_manager" invisible="registration_state not in ('suspended',)"/>
          <button name="action_graduate" type="object" string="Authorize Graduation" groups="kibabii-university-erp.group_registrar,kibabii-university-erp.group_university_manager" invisible="registration_state not in ('registered',)"/>
        </header>
        <sheet>
          <group>
            <field name="photo" widget="image"/>
            <field name="name"/>
            <field name="registration_number"/>
            <field name="admission_number"/>
            <field name="email"/>
            <field name="phone_number"/>
            <field name="user_id"/>
            <field name="university_id"/>
            <field name="programme_id"/>
            <field name="department_id"/>
            <field name="academic_year_id"/>
            <field name="intake"/>
            <field name="study_mode"/>
            <field name="year_of_study"/>
          </group>
          <notebook>
            <page string="Personal Details">
              <group>
                <field name="date_of_birth"/>
                <field name="gender"/>
                <field name="nationality_id"/>
                <field name="identity_type"/>
                <field name="identity_number" groups="kibabii-university-erp.group_registrar,kibabii-university-erp.group_university_manager"/>
                <field name="street"/>
                <field name="street2"/>
                <field name="city"/>
                <field name="state_id"/>
                <field name="country_id"/>
                <field name="postal_code"/>
              </group>
            </page>
            <page string="Family and Emergency">
              <group>
                <field name="guardian_name"/>
                <field name="guardian_relationship"/>
                <field name="guardian_phone"/>
                <field name="guardian_email"/>
                <field name="emergency_name"/>
                <field name="emergency_relationship"/>
                <field name="emergency_phone"/>
              </group>
            </page>
            <page string="Entry and Support">
              <group>
                <field name="previous_school"/>
                <field name="entry_qualification"/>
                <field name="qualification_year"/>
                <field name="sponsor_name"/>
                <field name="sponsor_contact"/>
                <field name="support_requirements" groups="kibabii-university-erp.group_registrar,kibabii-university-erp.group_university_manager"/>
              </group>
            </page>
            <page string="Documents">
              <group>
                <field name="document_ids" readonly="1"/>
              </group>
            </page>
            <page string="Course Registrations">
              <group>
                <field name="registration_ids" readonly="1"/>
              </group>
            </page>
            <page string="Published Academic Record">
              <group>
                <field name="published_result_ids" readonly="1"/>
                <field name="published_credits"/>
                <field name="published_gpa"/>
              </group>
            </page>
            <page string="Finance">
              <group>
                <field name="fee_ids" readonly="1"/>
                <field name="total_fee"/>
                <field name="total_paid"/>
                <field name="fee_balance"/>
              </group>
            </page>
            <page string="Progression and Graduation">
              <group>
                <field name="progression_ids" readonly="1"/>
                <field name="clearance_ids" readonly="1"/>
                <field name="academic_cleared"/>
                <field name="financial_cleared"/>
                <field name="library_cleared"/>
                <field name="graduation_blockers"/>
                <field name="graduation_eligible"/>
                <field name="graduation_by"/>
                <field name="graduation_on"/>
              </group>
            </page>
            <page string="Approvals">
              <group>
                <field name="decision_reason"/>
                <field name="admission_by"/>
                <field name="admission_on"/>
                <field name="registration_confirmed_by"/>
                <field name="registration_confirmed_on"/>
              </group>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
